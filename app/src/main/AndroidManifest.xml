<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mediqr.android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_medical_foreground"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".InicioSesionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".RegistroActivity" />
        <activity android:name=".PrincipalActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".DocumentosActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".HistorialActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mediqr.android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>