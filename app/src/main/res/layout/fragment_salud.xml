<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Heading1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expediente Clínico"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Información médica y antecedentes vitales"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />

            <!-- Alertas Críticas (Alergias Graves) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCriticalAlert"
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/severity_high"
                app:strokeColor="@color/sos_red"
                app:strokeWidth="1dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/sos_red" />
                    <TextView
                        android:id="@+id/tvCriticalAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="¡ALERTA!: Penicilina (Grave)"
                        android:textColor="@color/severity_high_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: Información Vital -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Información Vital"
                android:layout_marginTop="0dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include layout="@layout/row_medical_info" android:id="@+id/rowBlood" />
                    <include layout="@layout/divider_horizontal" />
                    <include layout="@layout/row_medical_info" android:id="@+id/rowAllergies" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: Tratamientos -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tratamientos Actuales" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include layout="@layout/row_medical_info" android:id="@+id/rowMeds" />
                    <include layout="@layout/divider_horizontal" />
                    <include layout="@layout/row_medical_info" android:id="@+id/rowChronic" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: Otros Antecedentes -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otros Antecedentes" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include layout="@layout/row_medical_info" android:id="@+id/rowVaccines" />
                    <include layout="@layout/divider_horizontal" />
                    <include layout="@layout/row_medical_info" android:id="@+id/rowSurgeries" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>