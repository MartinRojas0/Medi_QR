<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa de sombra/glow difuminada -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#60EF4444"
                android:endColor="#00EF4444" />
        </shape>
    </item>
    <!-- El botón en sí (triangular) -->
    <item
        android:drawable="@drawable/sos_triangle_background"
        android:top="12dp"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp" />
</layer-list>