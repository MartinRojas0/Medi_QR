<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health"
            android:textSize="28sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/MedicalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/allergies"
                    style="@style/InfoLabel" />

                <TextView
                    android:id="@+id/allergiesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InfoValue"
                    android:layout_marginTop="4dp"
                    android:text="Ninguna conocida"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_type"
                    style="@style/InfoLabel" />

                <TextView
                    android:id="@+id/bloodTypeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InfoValue"
                    android:layout_marginTop="4dp"
                    android:text="A+ (Positivo)"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chronic_conditions"
                    style="@style/InfoLabel" />

                <TextView
                    android:id="@+id/chronicConditionsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InfoValue"
                    android:layout_marginTop="4dp"
                    android:text="Hipertensión leve"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_medications"
                    style="@style/InfoLabel" />

                <TextView
                    android:id="@+id/currentMedicationsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InfoValue"
                    android:layout_marginTop="4dp"
                    android:text="Enalapril 10mg / día"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/documents"
                    style="@style/InfoLabel" />

                <TextView
                    android:id="@+id/documentsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/InfoValue"
                    android:layout_marginTop="4dp"
                    android:text="Toca aquí para ver tus documentos"
                    android:drawableEnd="@android:drawable/ic_menu_gallery"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>